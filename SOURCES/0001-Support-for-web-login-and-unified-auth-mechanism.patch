diff --git a/js/gdm/authMenuButton.js b/js/gdm/authMenuButton.js
new file mode 100644
index 000000000..5aaa45fd3
--- /dev/null
+++ b/js/gdm/authMenuButton.js
@@ -0,0 +1,514 @@
+/*
