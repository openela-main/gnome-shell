From 48e56b2d976f92aab044a74ef231dbf2e9edc362 Mon Sep 17 00:00:00 2001
From: Joan Torres Lopez <joantolo@redhat.com>
Date: Thu, 17 Sep 2026 13:00:32 +0200
Subject: [PATCH 2/6] loginDialog: Fix placing authPrompt with fixed height

The authPrompt is placed in a fixed y coordinate independently if its
height changes. However there's the special case: when WebLoginDialog is
displayed; it requires more height, so the fixed y coordinate is higher.

The original approach added a margin on top which was removed when
WebLoginDialog is visible. That margin affects the space required by the
banner text. To respect the banner space we need to remove that margin.
So now, remove the margin approach and just consider a higher fixed height
when WebLoginDialog is visible.

Part-of: <https://gitlab.gnome.org/GNOME/gnome-shell/-/merge_requests/4434>
---
 js/gdm/loginDialog.js | 15 ++++++++-------
 js/ui/unlockDialog.js | 10 ++++++----
 2 files changed, 14 insertions(+), 11 deletions(-)

diff --git a/js/gdm/loginDialog.js b/js/gdm/loginDialog.js
index 3b06615..5f3d2c6 100644
--- a/js/gdm/loginDialog.js
+++ b/js/gdm/loginDialog.js
@@ -37,7 +37,8 @@ const {MessageType} = imports.gdm.userVerifier;
 
 const _FADE_ANIMATION_TIME = 250;
 const _SCROLL_ANIMATION_TIME = 500;
-const _FIXED_TOP_ACTOR_HEIGHT = 300;
+const _FIXED_WEBLOGIN_HEIGHT = 550;
+const _FIXED_AUTHPROMPT_HEIGHT = 400;
 const _TIMED_LOGIN_IDLE_THRESHOLD = 5.0;
 const _PRIMARY_LOGIN_METHOD_SECTION_NAME = _('Login Options');
 const _SESSION_TYPE_SECTION_NAME = _('Session Type');
@@ -558,7 +559,7 @@ var LoginDialog = GObject.registerClass({
         return actorBox;
     }
 
-    _getFixedTopActorAllocation(dialogBox, actor) {
+    _getFixedTopActorAllocation(dialogBox, actor, fixedHeight) {
         const actorBox = new Clutter.ActorBox();
 
         let [, , natWidth, natHeight] = actor.get_preferred_size();
@@ -567,7 +568,7 @@ var LoginDialog = GObject.registerClass({
         const centerX = dialogBox.x1 + dialogWidth / 2;
         const centerY = dialogBox.y1 + dialogHeight / 2;
 
-        const top = centerY - _FIXED_TOP_ACTOR_HEIGHT / 2;
+        const top = centerY - fixedHeight / 2;
 
         natWidth = Math.min(natWidth, dialogWidth);
         natHeight = Math.min(natHeight, dialogHeight);
@@ -618,10 +619,10 @@ var LoginDialog = GObject.registerClass({
         let authPromptAllocation = null;
         let authPromptWidth = 0;
         if (this._authPrompt.visible) {
-            if (this._authPrompt.webLoginActive)
-                authPromptAllocation = this._getCenterActorAllocation(dialogBox, this._authPrompt);
-            else
-                authPromptAllocation = this._getFixedTopActorAllocation(dialogBox, this._authPrompt);
+            const fixedHeight = this._authPrompt.webLoginActive
+                ? _FIXED_WEBLOGIN_HEIGHT : _FIXED_AUTHPROMPT_HEIGHT;
+            authPromptAllocation =
+                this._getFixedTopActorAllocation(dialogBox, this._authPrompt, fixedHeight);
             authPromptWidth = authPromptAllocation.x2 - authPromptAllocation.x1;
         }
 
diff --git a/js/ui/unlockDialog.js b/js/ui/unlockDialog.js
index 01ff03b..478ccc3 100644
--- a/js/ui/unlockDialog.js
+++ b/js/ui/unlockDialog.js
@@ -28,7 +28,8 @@ const FADE_OUT_SCALE = 0.3;
 const BLUR_BRIGHTNESS = 0.55;
 const BLUR_SIGMA = 60;
 
-const FIXED_PROMPT_HEIGHT = 300;
+const FIXED_WEBLOGIN_HEIGHT = 550;
+const FIXED_AUTHPROMPT_HEIGHT = 400;
 
 const SUMMARY_ICON_SIZE = 32;
 
@@ -463,15 +464,16 @@ class UnlockDialogLayout extends Clutter.LayoutManager {
 
         // Authentication Box
         const dialog = container.get_parent();
+        const fixedHeight = dialog._authPrompt?.webLoginActive
+            ? FIXED_WEBLOGIN_HEIGHT : FIXED_AUTHPROMPT_HEIGHT;
         let stackY;
-        if (dialog._activePage === dialog._clock ||
-            dialog._authPrompt?.webLoginActive) {
+        if (dialog._activePage === dialog._clock) {
             stackY = Math.min(
                 Math.floor(centerY - stackHeight / 2.0),
                 height - stackHeight - maxNotificationsHeight);
         } else {
             stackY = Math.min(
-                Math.floor(centerY - FIXED_PROMPT_HEIGHT / 2.0),
+                Math.floor(centerY - fixedHeight / 2.0),
                 height - stackHeight - maxNotificationsHeight);
         }
 
-- 
