From c6d8ae1f8163c0d48ca0ed42a93840393b2cf764 Mon Sep 17 00:00:00 2001
From: Joan Torres Lopez <joantolo@redhat.com>
Date: Wed, 16 Sep 2026 20:55:12 +0200
Subject: [PATCH 1/6] webLogin: Don't grow the prompt layout for the web login
 dialog

The web-login-active style class widened .login-dialog-prompt-layout
so long URIs would fit, but that meant the auth prompt container
changed size when switching in and out of the web login flow.

Keep the container the same width as the regular auth prompt instead,
and let the URL label overflow past it when it doesn't fit its own
allocation. The container background is transparent, so the overflow
isn't visually jarring.

Part-of: <https://gitlab.gnome.org/GNOME/gnome-shell/-/merge_requests/4434>
---
 js/gdm/authPrompt.js |  2 --
 js/gdm/webLogin.js   | 44 +++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/js/gdm/authPrompt.js b/js/gdm/authPrompt.js
index 9073811..a997c28 100644
--- a/js/gdm/authPrompt.js
+++ b/js/gdm/authPrompt.js
@@ -559,7 +559,6 @@ var AuthPrompt = GObject.registerClass({
         this._mainBox.show();
 
         this.webLoginActive = false;
-        this.remove_style_class_name('web-login-active');
     }
 
     _openWebLoginDialog() {
@@ -571,7 +570,6 @@ var AuthPrompt = GObject.registerClass({
         this.updateSensitivity({sensitive: true});
 
         this.webLoginActive = true;
-        this.add_style_class_name('web-login-active');
     }
 
     _onVerificationFailed({serviceName, canRetry}) {
diff --git a/js/gdm/webLogin.js b/js/gdm/webLogin.js
index ef22010..ffcf0dd 100644
--- a/js/gdm/webLogin.js
+++ b/js/gdm/webLogin.js
@@ -11,6 +11,43 @@ const QR_CODE_SIZE = 150;
 const WEB_LOGIN_SPINNER_SIZE = 16;
 const URL_LABEL_LONG_THRESHOLD = 45;
 
+class LabelOverlayLayout extends Clutter.LayoutManager {
+    static {
+        GObject.registerClass(this);
+    }
+
+    vfunc_get_preferred_width(_container, _forHeight) {
+        return [0, 0];
+    }
+
+    vfunc_get_preferred_height(container, forWidth) {
+        const child = container.get_first_child();
+        return child ? child.get_preferred_height(forWidth) : [0, 0];
+    }
+
+    vfunc_allocate(container, box) {
+        const child = container.get_first_child();
+        if (!child)
+            return;
+
+        const [, naturalWidth] = child.get_preferred_width(-1);
+
+        if (naturalWidth <= box.get_width()) {
+            child.allocate(box);
+            return;
+        }
+
+        const center = (box.x1 + box.x2) / 2;
+        const overflowBox = new Clutter.ActorBox({
+            x1: Math.floor(center - naturalWidth / 2),
+            x2: Math.floor(center + naturalWidth / 2),
+            y1: box.y1,
+            y2: box.y2,
+        });
+        child.allocate(overflowBox);
+    }
+}
+
 var WebLoginPrompt = GObject.registerClass(
 class WebLoginPrompt extends St.BoxLayout {
     _init(params) {
@@ -45,9 +82,14 @@ class WebLoginPrompt extends St.BoxLayout {
 
         this._urlLabel = new St.Label({
             style_class: 'web-login-url-label',
+            xAlign: Clutter.ActorAlign.CENTER,
+        });
+        const urlLabelBin = new St.Widget({
+            layout_manager: new LabelOverlayLayout(),
             x_expand: true,
         });
-        this.add_child(this._urlLabel);
+        urlLabelBin.add_child(this._urlLabel);
+        this.add_child(urlLabelBin);
 
         this._codeBox = new St.BoxLayout({
             x_align: Clutter.ActorAlign.CENTER,
-- 
