From 90f34071cd7a5dfa657723284f4b3f7069e4b011 Mon Sep 17 00:00:00 2001
From: Joan Torres Lopez <joantolo@redhat.com>
Date: Thu, 17 Sep 2026 13:58:49 +0200
Subject: [PATCH 3/6] loginDialog: Increase height of banner on narrow mode

When the banner needs more space than the available and can't be
displayed in wide mode (one side the banner, the other side the
authPrompt), it'll be displayed above the authPrompt with a scrollView.

Instead of only giving 50% of the available space, give it 70%. So
it's not excessively shrunk.

Also, add a couple of fixes to make it look right:
  1. Vertically center the banner in the available space.
  2. Match the banner's width with the authPromt's width.

Part-of: <https://gitlab.gnome.org/GNOME/gnome-shell/-/merge_requests/4434>
---
 js/gdm/loginDialog.js | 15 ++++++---------
 1 file changed, 6 insertions(+), 9 deletions(-)

diff --git a/js/gdm/loginDialog.js b/js/gdm/loginDialog.js
index 5f3d2c6..a852431 100644
--- a/js/gdm/loginDialog.js
+++ b/js/gdm/loginDialog.js
@@ -655,7 +655,7 @@ var LoginDialog = GObject.registerClass({
             else
                 bannerSpace = 0;
 
-            let leftOverYSpace = bannerSpace - bannerHeight;
+            const leftOverYSpace = bannerSpace - bannerHeight;
 
             if (leftOverYSpace > 0) {
                 // First figure out how much left over space is up top
@@ -707,14 +707,11 @@ var LoginDialog = GObject.registerClass({
                     // If we aren't going to do a wide view, then we need to limit
                     // the height of the banner so it will present scrollbars
 
-                    // First figure out how much space there is without the banner
-                    leftOverYSpace += bannerHeight;
-
-                    // Then figure out how much of that space is up top
-                    let availableTopSpace = Math.floor(leftOverYSpace / 2);
-
-                    // Then give all of that space to the banner
-                    bannerAllocation.y2 = bannerAllocation.y1 + availableTopSpace;
+                    // Give 70% of the banner space to the banner itself, and
+                    // split the remaining 30% evenly above and below it
+                    const bannerSpacing = Math.floor(0.3 * bannerSpace);
+                    bannerAllocation.y1 += Math.floor(bannerSpacing / 2);
+                    bannerAllocation.y2 = bannerAllocation.y1 + (bannerSpace - bannerSpacing);
                 }
             }
         } else if (userSelectionAllocation) {
-- 
